    "price_unit": {
      "type": "string",
      "title": "\u0110\u01a1n v\u1ecb gi\u00e1"
    },
    "price_note": {
      "type": "string",
      "title": "Ghi ch\u00fa gi\u00e1"
    },
    "is_active": {
      "type": "boolean",
      "title": "\u0110ang hi\u1ec3n th\u1ecb",
      "default": true
    }
